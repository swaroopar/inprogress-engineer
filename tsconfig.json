{
    "compilerOptions": {
        "allowJs": true,
        "esModuleInterop": true,
        "jsx": "preserve",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "moduleResolution": "bundler",
        "module": "esnext",
        "noEmit": true,
        "paths": {
            "@site/*": ["./*"],
            "@site/src/components/*": ["./src/components/*"]
        },
        "skipLibCheck": true,
        "types": ["@docusaurus/plugin-ideal-image"],
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "./src/**/*.*",
        "babel.config.js",
        "types.d.ts",
        "docusaurus.config.ts",
        "tailwind.config.ts",
        "sidebars.ts"
    ],
    "exclude": ["node_modules", "build", ".docusaurus", "eslint.config.mjs"]
}
